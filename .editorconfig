root = true

# Kotlin SOURCE is generated by oagen at the official 4-space Kotlin indent.
[*.kt]
charset = utf-8
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true
ij_continuation_indent_size = 4
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

# Gradle SCRIPTS use 2 spaces, matching workos-kotlin so the build files stay
# directly diffable against the sibling SDK.
[*.kts]
charset = utf-8
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true
ij_continuation_indent_size = 2

[*.{yml,yaml,json,md}]
charset = utf-8
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

# Generated test suites embed response fixtures as inline string literals, and a
# JSON fixture routinely exceeds any sane line limit. It cannot be wrapped: string
# concatenation would be unreadable, and a Kotlin raw string interpolates `$`, which
# would turn spec-derived fixture data into live code. Main sources still enforce the
# limit. A stricter future option is emitting fixtures as test resources (the shape
# the Go and Python emitters use) instead of inline literals.
[src/test/kotlin/**/*.kt]
max_line_length = off
